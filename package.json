    "install:all": "npm install && cd client && npm install"
  },
  "dependencies": {
    "axios": "^1.10.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "csv-writer": "^1.6.0",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "express-validator": "^7.2.1",
    "helmet": "^8.0.0",
    "intuit-oauth": "^4.2.0",
    "json2csv": "^6.0.0-alpha.2",
    "jsonwebtoken": "^9.0.2",
    "moment": "^2.30.1",
    "multer": "^2.0.1",
    "node-quickbooks": "^2.0.46",
    "pdfkit": "^0.16.0",
    "sqlite3": "^5.1.7",
    "uuid": "^11.1.0",
    "xlsx": "^0.18.5"
  },
