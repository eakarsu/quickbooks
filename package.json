{
  "name": "quickbooks",
  "version": "2.0.0",
  "description": "Governed accounting and paper-broker reconciliation application",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "check": "node --check server.js && node scripts/check-source.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "test:unit": "node --test test/unit.test.js",
    "test:integration": "node --test --test-concurrency=1 test/integration.test.js",
    "test:e2e": "node --test --test-concurrency=1 test/e2e.test.js",
    "migrate": "node scripts/migrate.js",
    "migrate:check": "node scripts/migrate.js --check",
    "provision:admin": "node scripts/provision-admin.js",
    "create-admin": "node scripts/provision-admin.js",
    "backup": "node scripts/backup.js",
    "restore:verify": "node scripts/restore-verify.js",
    "client": "cd client && npm run dev",
    "client:build": "cd client && npm run build",
    "build": "npm run client:build",
    "install:all": "npm ci && npm --prefix client ci",
    "audit:prod": "npm audit --omit=dev --audit-level=low && npm --prefix client audit --omit=dev --audit-level=low"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "express-validator": "^7.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "pdfkit": "^0.17.2",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.10"
  },
  "engines": {
    "node": ">=22 <25"
  }
}
