{
  "name": "quickbooks",
  "version": "2.0.0",
  "description": "QuickBooks-like accounting application",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node scripts/setup-database.js",
