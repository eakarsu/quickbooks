NODE_ENV=production
PORT=5010
DATABASE_PATH=/var/lib/quickbooks/cashflow.db
JWT_SECRET=replace-with-at-least-32-random-characters
CORS_ORIGINS=https://ledger.example.com
TRUST_PROXY=1

# Each provider row references an environment variable; secrets are never stored in SQLite.
BROKER_ACME_WEBHOOK_SECRET=replace-with-at-least-32-random-characters

# Used only by the one-time administrator provisioning command.
ADMIN_USERNAME=operations-admin
ADMIN_EMAIL=operations@example.com
ADMIN_PASSWORD=replace-with-a-unique-14-character-password
# Local-only demo autofill. The ignored .env must provide one complete
# DEMO_*, SEED_ADMIN_*, ADMIN_*, or DEFAULT_* email/password pair.
ENABLE_DEMO_CREDENTIAL_AUTOFILL=false
